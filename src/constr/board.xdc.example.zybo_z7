# Physical constraints file for ZynqScriptedDSO
# (All interfaces are internal Zynq Processing System and Block Design signals)

# Declare AXI (clk_fpga_0) and DSO (clk_fpga_1) clock domains as asynchronous
set_clock_groups -asynchronous -group [get_clocks clk_fpga_0] -group [get_clocks clk_fpga_1]

# PMOD JC (ADC Data Input)
set_property -dict { PACKAGE_PIN V15   IOSTANDARD LVCMOS33 } [get_ports { adc_data_in[0] }]; #IO_L21P_T3_DQS_34 Sch=jc_p[1]
set_property -dict { PACKAGE_PIN W15   IOSTANDARD LVCMOS33 } [get_ports { adc_data_in[1] }]; #IO_L21N_T3_DQS_35 Sch=jc_n[1]
set_property -dict { PACKAGE_PIN T11   IOSTANDARD LVCMOS33 } [get_ports { adc_data_in[2] }]; #IO_L1P_T0_34 Sch=jc_p[2]
set_property -dict { PACKAGE_PIN T10   IOSTANDARD LVCMOS33 } [get_ports { adc_data_in[3] }]; #IO_L1N_T0_34 Sch=jc_n[2]
set_property -dict { PACKAGE_PIN W14   IOSTANDARD LVCMOS33 } [get_ports { adc_data_in[4] }]; #IO_L8P_T1_34 Sch=jc_p[3]
set_property -dict { PACKAGE_PIN Y14   IOSTANDARD LVCMOS33 } [get_ports { adc_data_in[5] }]; #IO_L8N_T1_34 Sch=jc_n[3]
set_property -dict { PACKAGE_PIN T12   IOSTANDARD LVCMOS33 } [get_ports { adc_data_in[6] }]; #IO_L2P_T0_34 Sch=jc_p[4]
set_property -dict { PACKAGE_PIN U12   IOSTANDARD LVCMOS33 } [get_ports { adc_data_in[7] }]; #IO_L2N_T0_34 Sch=jc_n[4]

# PMOD JD Pin 1 (ADC Clock Output)
set_property -dict { PACKAGE_PIN T14   IOSTANDARD LVCMOS33 } [get_ports { dso_clk_out }]; #IO_L5P_T0_34 Sch=jd_p[1]

