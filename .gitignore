# 1. Ignore everything by default
*
!*/

# 2. Whitelist your core folders
!src/
!scripts/
!docs/
!sw/
!README.md
!FRAMEWORK_GUIDE.md
!.gitignore
!Makefile
!vhdl_libs.txt
!sw_sources.txt

# 3. Whitelist specific file types
!*.vhd
!*.vhdl
!*.c
!*.h
!*.py
!*.tcl
!*.xdc
!sw/Makefile*

# 4. Explicitly ignore build artifacts
hw_build/
vitis_ws/
.Xil/
.gen/
*.log
*.jou
